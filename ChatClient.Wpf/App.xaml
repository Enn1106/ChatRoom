<Application x:Class="ChatClientWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <!-- Màu chủ đạo dùng chung. Sau khi chạy ổn có thể thay bằng MaterialDesignInThemes. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#4B5563"/>
    </Application.Resources>
</Application>
